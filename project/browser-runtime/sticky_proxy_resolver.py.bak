            "île-de-france": "fr", "ile-de-france": "fr", "provence": "fr",
            "normandy": "fr", "brittany": "fr", "alsace": "fr",
            # German states (Länder)
            "bavaria": "de", "saxony": "de", "hesse": "de", "brandenburg": "de",
            "baden-württemberg": "de", "baden-wurttemberg": "de",
            "north rhine-westphalia": "de", "berlin": "de", "hamburg": "de",
            "munich": "de", "münchen": "de",
            # UK constituent countries / regions
            "london": "gb", "manchester": "gb", "birmingham": "gb",
            "liverpool": "gb", "leeds": "gb", "glasgow": "gb", "edinburgh": "gb",
            "cardiff": "gb", "belfast": "gb",
            # Other major non-US cities (for backup-pool geo matching)
            "paris": "fr", "berlin": "de", "madrid": "es", "rome": "it",
            "amsterdam": "nl", "vienna": "at", "zurich": "ch", "geneva": "ch",
            "stockholm": "se", "oslo": "no", "copenhagen": "dk", "helsinki": "fi",
            "athens": "gr", "lisbon": "pt", "warsaw": "pl", "prague": "cz",
            "budapest": "hu", "moscow": "ru", "beijing": "cn", "shanghai": "cn",
            "seoul": "kr", "bangkok": "th", "jakarta": "id", "manila": "ph",
            "mumbai": "in", "delhi": "in", "dubai": "ae", "istanbul": "tr",
            "cairo": "eg", "lagos": "ng", "nairobi": "ke", "cape town": "za",
            "toronto": "ca", "vancouver": "ca", "montreal": "ca",
            "mexico city": "mx", "sao paulo": "br", "rio de janeiro": "br",
            "buenos aires": "ar", "santiago": "cl", "lima": "pe",
        }
        # Split on comma to get the last token (country/state)
        parts = [p.strip() for p in geo_lower.split(",")]
        # Try the LAST part first (most specific: state/country)
        for part in reversed(parts):
            if part in us_states or part in non_us_regions:
                return us_states.get(part) or non_us_regions[part]
            if part in us_state_abbrevs:
                return "us"
        # If no match, return 'us' as default
        return "us"


# SPR67: Canonical URL normalization for cache key consistency.
# Different callers may pass IPv6 hosts with or without brackets, or
# different cases for the scheme. Normalize before hashing.
def _canonicalize_proxy_url(proxy_url: str) -> str:
    """SPR67: Canonicalize a proxy URL for cache key consistency.

    - Lowercase the scheme
    - Bracket IPv6 hosts (e.g., 'fe80::1' → '[fe80::1]')
    - Strip port if it's the default for the scheme (e.g., :1080 for socks5)
    - Strip IPv6 zone IDs (RFC 6874) which are not allowed in brackets
    - Sort query parameters (none in proxy URLs but defense-in-depth)
    """
    if not proxy_url:
        return proxy_url
    try:
        parsed = urllib.parse.urlparse(proxy_url)
        scheme = (parsed.scheme or "socks5").lower()
        host = parsed.hostname or ""
        # Re-bracket IPv6 hosts (after stripping zone IDs)
        if host:
            # SPR76: Strip IPv6 zone IDs first (RFC 6874). The % in a URL
            # must be percent-encoded, so any % in the host is a zone ID.
            bare_host = host.split("%", 1)[0] if "%" in host else host
            try:
                ipaddress.IPv6Address(bare_host)
                # Use the bare host (without zone ID) in the brackets
                host = f"[{bare_host}]"
            except (ipaddress.AddressValueError, ValueError):
                # Not IPv6; keep as-is
                pass
        # Default ports per scheme
        default_ports = {"http": 80, "https": 443, "socks5": 1080, "socks5h": 1080}
        port = parsed.port
        netloc = parsed.netloc
        if host:
            userinfo = ""
            if parsed.username:
                userinfo = parsed.username
                if parsed.password:
                    userinfo += f":{parsed.password}"
                userinfo += "@"
            port_str = ""
            if port and port != default_ports.get(scheme):
                port_str = f":{port}"
            netloc = f"{userinfo}{host}{port_str}"
        # Reconstruct without query/fragment
        return urllib.parse.urlunparse((scheme, netloc, parsed.path, "", "", ""))
    except Exception:
        return proxy_url
