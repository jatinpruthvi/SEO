# SPR49: Typed exceptions so the orchestrator can distinguish failures
class ProxyUnavailableError(Exception):
    """Raised when no proxy (primary or backup) is alive."""
    def __init__(self, message: str, primary_error: str = "", attempts: int = 0):
        super().__init__(message)
        self.primary_error = primary_error
        self.attempts = attempts


class GeoBreachError(Exception):
    """Raised when no backup proxy is geo-consistent with the persona."""
    def __init__(self, message: str, required_geo: str, resolved_geo: str = ""):
        super().__init__(message)
        self.required_geo = required_geo
        self.resolved_geo = resolved_geo


# SPR56: Browser-like User-Agent for intelligence queries.
# Real Chrome 120 fingerprint. Using python-httpx UA is an instant
# Python automation signal — both Google and Cloudflare filter it.
_INTEL_USER_AGENT = (
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
    "AppleWebKit/537.36 (KHTML, like Gecko) "
    "Chrome/120.0.0.0 Safari/537.36"
)


# SPR31: City name normalization for ILIKE matching
def _normalize_city_name(city: str) -> str:
    """SPR31: Normalize city names for fuzzy matching.
    'St. Petersburg' → 'saint petersburg', 'New York City' → 'new york city'.
    """
    if not city:
        return ""
    city = city.lower().strip()
    # Common abbreviations
    city = _re.sub(r'\bst\.?\b', 'saint', city)
    city = _re.sub(r'\bmt\.?\b', 'mount', city)
    city = _re.sub(r'\bft\.?\b', 'fort', city)
    city = _re.sub(r'\bdr\.?\b', 'doctor', city)
    # Remove punctuation
    city = _re.sub(r'[.,]', '', city)
    return city.strip()


# SPR21: Fuzzy geo matching
def _fuzzy_geo_match(required_geo: str, resolved_geo: str) -> bool:
    """SPR21: Fuzzy match between required geo and resolved geo.

    The required_geo is a city name from the DB (e.g., "Dallas").
    The resolved_geo is "City, Region" (e.g., "Dallas, Texas" or
    "Plano, Texas"). A match is found if:
    1. The required city is a substring of the resolved city
       (e.g., "dallas" in "dallas"), OR
    2. The normalized required city matches the normalized
       resolved city (e.g., "saint petersburg" matches), OR
    3. The resolved city and required city are in the same
       state/region. E.g., "Dallas" (TX) matches "Plano, Texas"
       because both are in Texas.

    Returns True if any of the above match.
    """
    if not required_geo or not resolved_geo or resolved_geo == "unknown":
        return False
    req_lower = required_geo.lower().strip()
    res_lower = resolved_geo.lower().strip()

    # Method 1: Direct substring
    if req_lower in res_lower:
        return True

    # Method 2: Normalized match
    req_norm = _normalize_city_name(req_lower)
    res_norm = _normalize_city_name(res_lower.split(",")[0])
    if req_norm and (req_norm in res_norm or res_norm in req_norm):
        return True

    # Method 3: Same state/region match.
    # If the required_geo is a known city in a state, and the
    # resolved_geo contains the same state name, they're in the
    # same region. E.g., "Dallas" → state=TX, "Plano, Texas"
    # contains "texas" → match.
    us_state_to_cities = {
        "texas": {"dallas", "plano", "fort worth", "arlington", "austin",
                  "houston", "san antonio", "el paso", "irving", "garland",
                  "grand prairie", "mckinney", "frisco", "denton", "waco"},
        "california": {"los angeles", "san francisco", "san diego", "sacramento",
                       "san jose", "fresno", "oakland", "long beach"},
        "new york": {"new york", "brooklyn", "buffalo", "rochester", "yonkers",
                     "syracuse", "albany"},
        "florida": {"miami", "orlando", "tampa", "jacksonville", "st. petersburg",
                   "saint petersburg", "fort lauderdale", "tallahassee"},
    }
    us_state_abbrev_to_state = {
        "tx": "texas", "ca": "california", "ny": "new york", "fl": "florida",
    }

    # Check if required_geo is a known city in a state
    for state, cities in us_state_to_cities.items():
        if req_norm in cities:
            # Required city is in this state. Check if resolved
            # geo contains the same state name.
            if state in res_lower:
                return True
    # Also check if required_geo is a state abbrev
    for abbrev, state in us_state_abbrev_to_state.items():
        if req_lower == abbrev and state in res_lower:
            return True

    return False



