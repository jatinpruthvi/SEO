# CF-9 (Pass 18): Safe env var parser. See hardened_orchestrator.py
# for the canonical implementation. We duplicate the helper here
# (rather than cross-import) because sticky_proxy_resolver.py is
# imported by hardened_orchestrator.py — circular import risk.
def _safe_getenv_int(name: str, default: int, min_value: int = 0, max_value: int = 2147483647) -> int:
    """CF-9 (Pass 18): Safe int env var parser with max_value support.
    DC-41 (Pass 41): Added max_value to prevent resource exhaustion.
    """
    raw = _os.getenv(name)
    if raw is None or raw.strip() == "":
        return default
    try:
        val = int(raw)
    except (ValueError, TypeError):
        logger.warning(f"CF-9: env var {name}='{raw}' is not an integer; using default {default}")
        return default
    if val < min_value:
        logger.warning(f"CF-9: env var {name}={val} is below minimum {min_value}; clamping to {min_value}")
        return min_value
    if val > max_value:
        logger.warning(f"CF-9: env var {name}={val} is above maximum {max_value}; clamping to {max_value}")
        return max_value
    return val


    return val


