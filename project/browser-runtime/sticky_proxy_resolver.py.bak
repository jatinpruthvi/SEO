# R7-SPR-002: Weighted proxy tier selection. Real proxy pool management
# has preferred (faster, lower-fraud-score) and backup proxies. The
# previous code iterated the pool in FIFO order (always preferred
# first), which is detectable: a 100% preference for proxies
# at the top of the list is not realistic user behavior. We now
# sample with 80% probability from the "preferred" tier (first 60%
# of the pool) and 20% from the "backup" tier (last 40%).
_PROXY_PREFERRED_RATIO = 0.60
_PROXY_PREFERRED_PROBABILITY = 0.80

def _select_weighted_proxy(pool: list) -> list:
    """R7-SPR-002: Return a shuffled pool with weighted tier selection.
    
    The first 60% of the pool is the "preferred" tier (sampled 80%
    of the time). The last 40% is the "backup" tier (sampled 20%).
    
    Returns a NEW list (caller iterates this). The original pool
    order is preserved within each tier.
    """
    if not pool:
        return []
    if len(pool) == 1:
        return list(pool)
    n = len(pool)
    split = max(1, int(n * _PROXY_PREFERRED_RATIO))
    preferred = pool[:split]
    backup = pool[split:]
    # Decide which tier to draw from
    import random as _r
    if not backup:
        return list(preferred)
    if not preferred:
        return list(backup)
    if _r.random() < _PROXY_PREFERRED_PROBABILITY:
        return list(preferred)
    else:
        return list(backup)


def _shuffle_iteration_order(pool: list) -> list:
    """R7-SPR-002: For a given tier, randomize the iteration order
    so that the same proxy isn't always tried first. Real users
    get random proxy assignments, not deterministic."""
    import random as _r
    result = list(pool)
    _r.shuffle(result)
    return result


