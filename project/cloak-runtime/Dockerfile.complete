# Dockerfile.complete - CloakBrowser + cloak-runtime + VNC + noVNC
#
# This is the PRODUCTION-READY image that addresses all 4 gaps in the
# base Dockerfile. Build and run with docker-compose.
#
# Build:   docker build -f Dockerfile.complete -t cloak-complete .
# Run:     docker-compose -f docker-compose.complete.yml up -d
# Then:    open http://localhost:6080/vnc.html

FROM python:3.10-slim-bullseye

LABEL maintainer="CloakBrowser Project"
LABEL description="CloakBrowser + cloak-runtime + VNC + noVNC. Anti-fingerprinting browser with GUI access."

# ============================================================
# 1. System dependencies: X11, VNC, fonts, Chromium runtime deps
# ============================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget \
        gnupg2 \
        curl \
        ca-certificates \
        # X11 + VNC
        xvfb \
        x11vnc \
        xdotool \
        scrot \
        fluxbox \
        xterm \
        # Chromium runtime dependencies
        libgtk-3-0 \
        libx11-xcb1 \
        libxss1 \
        libnss3 \
        libasound2 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libxkbcommon0 \
        libgbm1 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        # Fonts (CreepJS checks for font list)
        fonts-liberation \
        fonts-noto-color-emoji \
        fonts-dejavu-core \
        # Utilities
        procps \
        net-tools \
        tini \
        jq \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# 2. Node.js 20 (for Playwright/Puppeteer and cloak-runtime)
# ============================================================
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version && npm --version

# ============================================================
# 3. noVNC + websockify (browser-based VNC access)
# ============================================================
ENV NOVNC_VERSION=1.4.0
RUN cd /opt && \
    wget -q https://github.com/novnc/noVNC/archive/v${NOVNC_VERSION}.tar.gz && \
    tar xzf v${NOVNC_VERSION}.tar.gz && \
    rm v${NOVNC_VERSION}.tar.gz && \
    mv noVNC-${NOVNC_VERSION} novnc && \
    chmod +x /opt/novnc/utils/launch.sh
RUN pip3 install --no-cache-dir websockify

# ============================================================
# 4. Python deps + CloakBrowser wrapper
# ============================================================
WORKDIR /opt/cloak

# Copy Python requirements first for better Docker layer caching
COPY requirements.txt* pyproject.toml* setup.py* ./
RUN pip install --no-cache-dir \
        playwright \
        pyppeteer \
        requests \
        aiohttp \
        loguru \
    || echo "Some Python deps not installable, continuing..."

# Install CloakBrowser (assumes it's available as a Python package or wheel)
# If you have a private index, configure it before this line
RUN pip install --no-cache-dir cloakbrowser || \
    echo "WARNING: cloakbrowser not on PyPI. Install from your private index."

# Pre-download the stealth Chromium binary during build
# This caches it in the image so first run is fast
RUN python -c "from cloakbrowser import ensure_binary; ensure_binary()" \
    && rm -f ~/.cloakbrowser/.welcome_shown

# ============================================================
# 5. cloak-runtime npm package (your JS patches)
# ============================================================
WORKDIR /opt/cloak-runtime
COPY cloak-runtime/package.json ./
COPY cloak-runtime/src/ ./src/
COPY cloak-runtime/manifests/ ./manifests/
COPY cloak-runtime/scripts/ ./scripts/
COPY cloak-runtime/test/ ./test/

# Link the anti_detect_signature.js from the main project
RUN mkdir -p /opt/cloak-runtime/src && \
    cp -n /home/user/project/browser-runtime/anti_detect_signature.js ./src/ || \
    echo "anti_detect_signature.js not found at expected path"

RUN npm install --omit=dev --no-audit --no-fund

# Build dist/ from all manifests (pre-generates the JS)
RUN node scripts/build.js

# Make cloak available globally
RUN npm link

# ============================================================
# 6. VNC password setup (default: cloak, change for production)
# ============================================================
RUN mkdir -p /root/.vnc && \
    x11vnc -storepasswd cloak /root/.vnc/passwd

# ============================================================
# 7. Demo persona runner (Python - tests the full stack)
# ============================================================
RUN cat > /opt/cloak-runtime/demo.py << 'PYEOF'
#!/usr/bin/env python3
"""demo.py - End-to-end demo: CloakBrowser + cloak-runtime + CreepJS visit.

This proves the full pipeline works: C++-level patches from CloakBrowser
+ JS-level patches from cloak-runtime applied together.
"""
import asyncio
import json
import os
import sys
from pathlib import Path

try:
    from cloakbrowser import launch as cloak_launch
except ImportError:
    print("ERROR: cloakbrowser not installed", file=sys.stderr)
    sys.exit(1)


async def main():
    persona = os.environ.get("PERSONA", "chrome-128-win")
    print(f"[demo] Starting CloakBrowser with persona={persona}")

    # Step 1: Launch CloakBrowser (C++-level patches)
    browser = await cloak_launch(
        headless=os.environ.get("HEADLESS", "1") == "1",
        proxy=os.environ.get("HTTP_PROXY"),  # Pick up proxy from env
    )

    try:
        context = await browser.new_context(
            viewport={"width": 1920, "height": 1080},
        )

        # Step 2: Inject cloak-runtime (JS-level patches)
        runtime_path = Path(f"/opt/cloak-runtime/dist/{persona}.js")
        if runtime_path.exists():
            runtime = runtime_path.read_text()
            await context.add_init_script(content=runtime)
            print(f"[demo] Loaded {len(runtime)} bytes of JS patches")
        else:
            print(f"WARNING: {runtime_path} not found, JS patches skipped")

        # Step 3: Inject anti_detect_signature.js
        sig_path = Path("/opt/cloak-runtime/src/anti_detect_signature.js")
        if sig_path.exists():
            await context.add_init_script(content=sig_path.read_text())
            print(f"[demo] Loaded anti_detect_signature.js")

        page = await context.new_page()

        # Step 4: Visit CreepJS
        print("[demo] Navigating to CreepJS...")
        try:
            await page.goto("https://abrahamjuliot.github.io/creepjs/",
                            wait_until="networkidle", timeout=60000)
            await page.wait_for_timeout(15000)

            result = await page.evaluate("""() => ({
                userAgent: navigator.userAgent,
                webdriver: navigator.webdriver,
                platform: navigator.platform,
                hardwareConcurrency: navigator.hardwareConcurrency,
                deviceMemory: navigator.deviceMemory,
                languages: navigator.languages,
                timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
                screenWidth: screen.width,
                screenHeight: screen.height,
                colorDepth: screen.colorDepth,
                cloak_salt: window.__cloak_signature_salt__,
                cloak_session: window.__cloak_session_id__,
                cloak_runtime: window.__cloak_runtime__?.name,
                patchCount: window.__cloak_runtime__?.patchCount,
            })""")

            print("\n=== Fingerprint Report ===")
            print(json.dumps(result, indent=2))

            # Save to a file the host can read
            out_path = Path("/tmp/creepjs-result.json")
            out_path.write_text(json.dumps(result, indent=2))
            print(f"\n[demo] Saved to {out_path}")
        except Exception as e:
            print(f"[demo] CreepJS visit failed: {e}")
    finally:
        await browser.close()


if __name__ == "__main__":
    asyncio.run(main())
PYEOF
RUN chmod +x /opt/cloak-runtime/demo.py

# ============================================================
# 8. Entry point - starts Xvfb, VNC, noVNC, then runs the app
# ============================================================
RUN cat > /opt/cloak-runtime/entrypoint.sh << 'BASHEOF'
#!/bin/bash
# entrypoint.sh - Start virtual display, VNC, noVNC, then launch app

set -e

# Use tini for proper signal handling (PID 1 reaping)
export DISPLAY=:99
export RESOLUTION=${RESOLUTION:-1920x1080x24}
export VNC_PASSWORD=${VNC_PASSWORD:-cloak}
export VNC_PORT=${VNC_PORT:-5900}
export NOVNC_PORT=${NOVNC_PORT:-6080}

# Re-set VNC password if changed
if [ "$VNC_PASSWORD" != "cloak" ]; then
    x11vnc -storepasswd "$VNC_PASSWORD" /root/.vnc/passwd
fi

echo "[cloak] Starting Xvfb on :99 at $RESOLUTION..."
Xvfb :99 -screen 0 "$RESOLUTION" -ac &
XVFB_PID=$!
sleep 1

echo "[cloak] Starting Fluxbox (window manager)..."
fluxbox &
sleep 1

echo "[cloak] Starting x11vnc on port $VNC_PORT..."
x11vnc -display :99 \
       -forever \
       -shared \
       -rfbport $VNC_PORT \
       -rfbauth /root/.vnc/passwd \
       -bg \
       -o /var/log/x11vnc.log
sleep 1

echo "[cloak] Starting noVNC on port $NOVNC_PORT..."
/opt/novnc/utils/launch.sh \
    --listen $NOVNC_PORT \
    --vnc localhost:$VNC_PORT \
    --web /opt/novnc &
sleep 2

echo ""
echo "============================================="
echo "  cloak-complete is running!"
echo "  VNC:     localhost:$VNC_PORT  (password: $VNC_PASSWORD)"
echo "  noVNC:   http://localhost:$NOVNC_PORT/vnc.html"
echo "============================================="
echo ""

# Mode selection
if [ "${DEMO:-0}" = "1" ]; then
    echo "[cloak] DEMO=1, running demo.py..."
    cd /opt/cloak-runtime
    exec python3 demo.py
elif [ "${INTERACTIVE:-0}" = "1" ]; then
    echo "[cloak] INTERACTIVE=1, launching Chromium..."
    exec chromium-browser \
        --no-sandbox \
        --disable-dev-shm-usage \
        --window-size=1920,1080 \
        --window-position=0,0 \
        "https://abrahamjuliot.github.io/creepjs/"
else
    # Default: keep VNC running, run the user's main.py
    if [ -f /app/main.py ]; then
        echo "[cloak] Running /app/main.py..."
        cd /app
        exec python3 main.py
    else
        echo "[cloak] No /app/main.py, idle. Connect VNC to launch apps manually."
        # Keep the container alive
        while true; do sleep 3600; done
    fi
fi
BASHEOF
RUN chmod +x /opt/cloak-runtime/entrypoint.sh

# ============================================================
# 9. Expose ports and metadata
# ============================================================
EXPOSE 5900 6080

# Volume for persona data, results
VOLUME ["/data", "/root/.cloak"]

# Environment defaults
ENV RESOLUTION=1920x1080x24 \
    VNC_PASSWORD=cloak \
    VNC_PORT=5900 \
    NOVNC_PORT=6080 \
    DISPLAY=:99 \
    CLOAKBROWSER_NO_SANDBOX=true \
    PYTHONUNBUFFERED=1

# Healthcheck - verify noVNC is responding
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:${NOVNC_PORT}/ > /dev/null || exit 1

# tini for proper signal handling
ENTRYPOINT ["/usr/bin/tini", "--"]

# Default command: start VNC + noVNC + (demo or app or idle)
CMD ["/opt/cloak-runtime/entrypoint.sh"]
